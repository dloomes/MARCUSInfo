{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "M.A.R.C.U.S.",
  "colors": {
    "primary": "#2A1B5E",
    "light": "#4FC3E0",
    "dark": "#C8156A"
