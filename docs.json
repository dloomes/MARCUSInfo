        "icon": "rocket-launch",
        "pages": [
          "deploy/overview",
          {
            "group": "Plan",
            "pages": [
              "deploy/topologies",
              "deploy/network-requirements",
              "deploy/sizing"
            ]
          },
          {
            "group": "Install",
            "pages": [
              "deploy/install-linux",
              "deploy/install-windows",
              "deploy/docker",
              "deploy/kubernetes",
              "deploy/managed-containers",
              "deploy/configuration"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "deploy/updates",
              "deploy/monitoring",
              "deploy/backup"
            ]
          }
        ]
      },
      {
        "group": "Supported devices",
        "icon": "plug-circle-check",
        "pages": [
          "devices/overview",
          {
            "group": "Vendor adapters",
            "pages": [
              "devices/aten-pdu",
              "devices/aurora-rxt",
              "devices/aurora-vpx",
              "devices/poly-videoos",
              "devices/sony-bravia",
              "devices/tesira",
              "devices/visca-over-ip"
            ]
          },
          {
            "group": "Generic adapters",
            "pages": [
              "devices/rest",
              "devices/websocket",
              "devices/telnet",
              "devices/serial",
              "devices/ping"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/marcus-light.svg",
    "dark": "/images/marcus-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@involve.vc"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.uat.involvecloud.com"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "light"
